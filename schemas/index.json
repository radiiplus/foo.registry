{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/radiiplus/foo.registry/main/schemas/index.json",
  "title": "Foo registry shard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "count", "entries"],
  "properties": {
    "schema": { "const": "foo.index/v1" },
    "count": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "entry.json" }
    }
  }
}
