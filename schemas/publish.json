{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/radiiplus/foo.registry/main/schemas/publish.json",
  "title": "Foo publication request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifest", "documentation", "source"],
  "properties": {
    "schema": { "const": "foo.publish/v1" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "name", "version", "description", "category", "tags", "license", "compatible", "deprecated", "platforms", "updated", "repository", "revision", "install", "dependencies"],
      "properties": {
        "schema": { "const": "foo.package/v1" },
        "name": { "type": "string", "pattern": "^(?:@[a-z0-9][a-z0-9-]{0,38}/)?[a-z][a-z0-9-]{0,63}$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 280 },
        "category": { "type": "string", "minLength": 1 },
        "tags": { "$ref": "package.json#/$defs/tokens" },
        "license": { "type": "string", "minLength": 1 },
        "compatible": { "type": "boolean" },
        "deprecated": { "type": "string" },
        "platforms": { "$ref": "package.json#/$defs/tokens" },
        "updated": { "type": "string", "format": "date" },
        "repository": { "type": "string", "format": "uri", "pattern": "^https://" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "install": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "$ref": "package.json#/$defs/dependency" } }
      }
    },
    "documentation": {
      "type": "array",
      "minItems": 100,
      "items": { "type": "string", "minLength": 1 }
    },
    "source": { "$ref": "package.json#/$defs/source" }
  }
}
