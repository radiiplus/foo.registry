{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/radiiplus/foo.registry/main/schemas/package.json",
  "title": "Foo package release",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "name", "version", "description", "category", "tags", "license", "compatible", "deprecated", "platforms", "updated", "owner", "repository", "revision", "install", "dependencies", "readme", "source", "api"],
  "properties": {
    "schema": { "const": "foo.package/v1" },
    "kind": { "enum": ["package", "standard"] },
    "name": { "type": "string", "pattern": "^(?:@[a-z0-9][a-z0-9-]{0,38}/[a-z][a-z0-9-]{0,63}|std/[a-z][a-z0-9-]{0,63}(?:/[a-z][a-z0-9-]{0,63})*|[a-z][a-z0-9-]{0,63})$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 280 },
    "category": { "type": "string", "pattern": "^[a-z0-9][a-z0-9 -]{0,63}$" },
    "tags": { "$ref": "#/$defs/tokens" },
    "license": { "type": "string", "minLength": 1 },
    "compatible": { "type": "boolean" },
    "deprecated": { "type": "string" },
    "platforms": { "$ref": "#/$defs/tokens" },
    "updated": { "type": "string", "format": "date" },
    "owner": { "$ref": "#/$defs/owner" },
    "repository": { "type": "string", "format": "uri", "pattern": "^https://" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "install": { "type": "string", "minLength": 1 },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "readme": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source": { "$ref": "#/$defs/source" },
    "api": { "$ref": "#/$defs/api" }
  },
  "$defs": {
    "tokens": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "login"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "login": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "kind", "platforms"],
      "properties": {
        "name": { "type": "string", "pattern": "^(?:@[a-z0-9][a-z0-9-]{0,38}/)?[a-z][a-z0-9-]{0,63}$" },
        "version": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["runtime", "dev", "optional", "platform"] },
        "platforms": { "$ref": "#/$defs/tokens" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "digest", "files"],
      "properties": {
        "format": { "const": "foo.source/v1" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "content": { "type": "string" }
            }
          }
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "modules"],
      "properties": {
        "schema": { "const": "foo.api/v1" },
        "modules": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path", "summary", "items"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "pattern": "^[^/].*\\.iv$" },
              "summary": { "type": "string" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "name", "signature", "documentation"],
                  "properties": {
                    "kind": { "enum": ["function", "type", "constant", "value"] },
                    "name": { "type": "string", "minLength": 1 },
                    "signature": { "type": "string", "minLength": 1 },
                    "documentation": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
