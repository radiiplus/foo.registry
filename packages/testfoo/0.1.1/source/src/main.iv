-- Provides predictable arithmetic helpers for registry integration testing.
public constant version is "0.1.0".
public function double(value integer) giving integer {
  give value multiply 2.
}
public function square(value integer) giving integer {
  give value multiply value.
}
public function increment(value integer) giving integer {
  give value plus 1.
}
public function decrement(value integer) giving integer {
  give value subtract 1.
}
